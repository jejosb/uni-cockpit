# Personal RELAX calendar export URL (Calendar → Import/Export → Get calendar URL).
# It contains a secret authtoken. Never commit the real value.
# RELAX_ICAL_URL=https://relax.reutlingen-university.de/calendar/export_execute.php?userid=YOUR_USER_ID&authtoken=YOUR_TOKEN&preset_what=courses&preset_time=custom
RELAX_ICAL_URL=

# Local SQLite database. The file is git-ignored.
DATABASE_URL=sqlite:///data/cockpit.db

# Allow file:// URLs, local .ics paths, and http://localhost for development.
# Keep this false on any deployed server: an enabled flag lets the process
# read local files and call http://127.0.0.1. Unset and false mean the same thing.
DEV_ALLOW_LOCAL_FEEDS=false

# Hours before a deadline to send one Telegram reminder. Default is 72,24
# (3 days and 24 hours). Each value is a whole number of real elapsed UTC
# hours from 1 to 720, not Berlin wall-clock hours. A 72-hour reminder that
# crosses the 25 October clock change is one hour off on the Berlin clock,
# by design. See README, section "Time handling".
# If any entry is invalid, the app logs a warning and falls back to 72,24.
# It does not crash. Run one uvicorn worker; more workers send each reminder
# once per worker.
REMINDER_OFFSETS_HOURS=72,24

# Telegram bot from @BotFather, and the chat that should receive reminders.
# Leave both empty to run the cockpit without reminders; the log says they
# are disabled. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Story 4 (not implemented yet).
# SYNC_INTERVAL_MINUTES=60

# Story 5 (not implemented yet).
# HISINONE_ICAL_URL=
