# Personal RELAX calendar export URL (Calendar → Import/Export → Get calendar URL).
# It contains a secret authtoken. Never commit the real value.
# RELAX_ICAL_URL=https://relax.reutlingen-university.de/calendar/export_execute.php?userid=YOUR_USER_ID&authtoken=YOUR_TOKEN&preset_what=courses&preset_time=custom
RELAX_ICAL_URL=

# Local SQLite database. The file is git-ignored.
DATABASE_URL=sqlite:///data/cockpit.db

# Allow file:// URLs, local .ics paths, and http://localhost for development.
# Keep this false on any deployed server: an enabled flag lets the process
# read local files and call http://127.0.0.1. Unset and false mean the same thing.
DEV_ALLOW_LOCAL_FEEDS=false

# Comma-separated hostnames that may serve calendar feeds (exact match, no subdomain wildcard).
# Comparison ignores case and a single trailing dot. Blank entries are ignored.
# An empty value keeps the default below; it does not allow every host.
# If any entry is invalid (a URL, a port, a wildcard, a path, a space inside the
# name, or an IP address), the app logs one warning and uses the default for the
# whole value. The warning does not repeat the value. The app does not crash.
# The timetable host is not included. Add that exact hostname when you have the export URL.
FEED_ALLOWED_HOSTS=relax.reutlingen-university.de

# Hours before a deadline to send one Telegram reminder. Default is 72,24
# (3 days and 24 hours). Each value is a whole number of real elapsed UTC
# hours from 1 to 720, not Berlin wall-clock hours. A 72-hour reminder that
# crosses the 25 October clock change is one hour off on the Berlin clock,
# by design. See README, section "Time handling".
# If any entry is invalid, the app logs a warning and falls back to 72,24.
# It does not crash. Run one uvicorn worker; more workers send each reminder
# once per worker.
REMINDER_OFFSETS_HOURS=72,24

# Telegram bot from @BotFather, and the chat that should receive reminders.
# Leave both empty to run the cockpit without reminders; the log says they
# are disabled. Never commit real values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often to re-fetch the RELAX feed, in whole minutes. Default is 60.
# The value must be from 1 to 10080 (7 days). If it is invalid, the app logs
# a warning and falls back to 60. It does not crash. The download runs off
# the event loop. One uvicorn worker only; a second worker would refresh
# and remind once per worker.
SYNC_INTERVAL_MINUTES=60

# Personal HISinOne timetable export (iCalendar). It may contain a secret token.
# Never commit the real value. The link often has to be created again after a
# semester change. The host is not part of the default FEED_ALLOWED_HOSTS list
# (relax.reutlingen-university.de only). Add the exact HISinOne hostname there
# or the fetch is rejected.
# HISINONE_ICAL_URL=https://example.edu/hisinone/timetable.ics?token=YOUR_TOKEN
HISINONE_ICAL_URL=

# Key for the CSRF tokens that every form and HTMX request sends with a POST.
# Optional. Unset or empty means a random key per process: the cockpit still
# works, but a page that was open before a restart needs a reload. Set a long
# random value (for example `python3 -c "import secrets; print(secrets.token_urlsafe(32))"`)
# on a deployed server. Never commit the real value.
CSRF_SECRET=
